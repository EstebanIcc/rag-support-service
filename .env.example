# OpenAI
OPENAI_API_KEY=sk-...tu-api-key-aqui

# Servidor
PORT=3000

# RAG Config
CHUNK_SIZE=500          # Tamaño de cada chunk en caracteres
CHUNK_OVERLAP=50        # Superposición entre chunks
TOP_K=5                 # Número de chunks a recuperar por pregunta
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Módulo: Tickets (ej: Zendesk, Jira, Freshdesk)
TICKETS_API_URL=https://tu-sistema-tickets.com/api
TICKETS_API_KEY=tu-api-key-tickets

# Módulo: Pedidos (ej: ecommerce, ERP)
ORDERS_API_URL=https://tu-sistema-pedidos.com/api
ORDERS_API_KEY=tu-api-key-pedidos

# Módulo: Jelou Tickets
# Si no se define, usa el token por defecto del módulo
JELOU_API_TOKEN=tu-token-base64-jelou

# LLM Provider: 'openai' (default) | 'jelou'
LLM_PROVIDER=jelou

# Jelou Tools LLM (solo si LLM_PROVIDER=jelou)
JELOU_TOOLS_URL=https://gateway.jelou.ai/workflows/v2/tools/7834/execute
JELOU_TOOLS_API_KEY=3881|Ia1EpRK1uhFo3kaQAsCeQm7Ybnv1DJaE48yoXWqI
JELOU_TOOLS_VERSION=1

# Jelou Database — contexto de conversación por sesión (DB 9929)
# Token JWT de tu cuenta Jelou (obténlo desde apps.jelou.ai)
JELOU_DB_TOKEN=tu-jwt-token-jelou
