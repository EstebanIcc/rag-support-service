
# OpenAI
OPENAI_API_KEY=sk-...

# Servidor
PORT=3000

# RAG Config
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# LLM Provider: 'openai' (default) | 'jelou'
LLM_PROVIDER=jelou

# Jelou Tools LLM
JELOU_TOOLS_URL=https://gateway.jelou.ai/workflows/v2/tools/7834/execute
JELOU_TOOLS_API_KEY=3881|...
JELOU_TOOLS_VERSION=2

# Jelou Datum DB — contexto de conversación (token Basic, expira 12h)
JELOU_DB_TOKEN=...

# Jelou API — tickets y transferencias (token Basic)
JELOU_API_TOKEN=...

# Transferencia de ticket a plataforma (POST /v1/support-tickets/assign)
JELOU_TRANSFER_OPERATOR_ID=10360

# PocketBase — Knowledge Base (módulos PDF)
RAG_DB_URL=https://base-rag-sgtsaq.jelou.cloud
RAG_DB_API_KEY=...
