{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {}
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "uploads"]
}
